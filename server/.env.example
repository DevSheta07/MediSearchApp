# Example environment variables for server
# Copy to `.env` locally and set real values.
MONGO_URI=mongodb://127.0.0.1:27017/aushadhsetu
JWT_SECRET=your_new_strong_jwt_secret_here
PORT=8000

# Email configurations for sending Reset Password links (Resend HTTP API - Recommended for Render)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=onboarding@resend.dev

# Backup: Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
